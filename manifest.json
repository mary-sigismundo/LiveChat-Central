
{
    "manifest_version": 3,
    "name": "Comentários da Live – PES",
    "version": "2.3.0",
    "description": "Reúne comentários de transmissões ao vivo do YouTube e Facebook em um único painel.",
    "icons": {
        "16": "icons/icon.png",
        "32": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
    },
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://www.facebook.com/*",
        "https://m.facebook.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Abrir Comentários da Live – PES",
        "default_icon": {
            "16": "icons/icon.png",
            "32": "icons/icon.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*"
            ],
            "js": [
                "partes.js",
                "youtube.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        },
        {
            "matches": [
                "https://www.facebook.com/*",
                "https://m.facebook.com/*"
            ],
            "js": [
                "facebook.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}
